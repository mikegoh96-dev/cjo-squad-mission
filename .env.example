# Copy to .env.local and fill in. Never commit .env.local or real keys.
# Values: Supabase dashboard > Project Settings > API Keys / Data API.

# Project URL, e.g. https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Publishable key (sb_publishable_...). Safe for the browser; access is
# enforced by Row Level Security. The legacy anon key also works here.
# NEVER put the secret / service_role key in a NEXT_PUBLIC_ variable.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# PUSH NOTIFICATIONS (optional; without them the feature is hidden).
# Generate VAPID keys with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# Server only: never NEXT_PUBLIC_, never commit a value.
VAPID_PRIVATE_KEY=
# Server only: random 32+ characters. Store sha256(PUSH_SECRET) in
# private.push_settings (see CLAUDE.md). Never commit a value.
PUSH_SECRET=
# Server only: random 32+ characters. Supabase Cron sends it to /api/notify/run
# (store the same value in Supabase Vault as cjo_cron_secret). Never commit a value.
CRON_SECRET=
# Optional contact URL for push services (defaults to the Vercel production URL).
# VAPID_SUBJECT=https://your-app.vercel.app

# ADMIN SCRIPT ONLY (npm run members). Secret key from API Keys (sb_secret_...).
# Never prefix with NEXT_PUBLIC_, never add to Vercel, never commit a value.
# SUPABASE_SECRET_KEY=
