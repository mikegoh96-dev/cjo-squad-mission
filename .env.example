# Copy to .env.local and fill in. Never commit .env.local or real keys.
# Values: Supabase dashboard > Project Settings > API Keys / Data API.

# Project URL, e.g. https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Publishable key (sb_publishable_...). Safe for the browser; access is
# enforced by Row Level Security. The legacy anon key also works here.
# NEVER put the secret / service_role key in a NEXT_PUBLIC_ variable.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
